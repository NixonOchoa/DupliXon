<Window x:Class="DupliXon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DupliXon.App.ViewModels"
        xmlns:v="clr-namespace:DupliXon.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DupliXon" Width="460" Height="800" MinWidth="420" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Icon="/Assets/DupliXon.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:SegmentStateConverter x:Key="Seg" />
        <v:VisibleWhenConverter x:Key="Visible" />
        <v:VisibleWhenConverter x:Key="Hidden" Invert="True" />
    </Window.Resources>

    <Grid>
        <!-- Tint over the system acrylic; also the fallback look on Windows 10. -->
        <Border x:Name="Tint">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#99101830" Offset="0" />
                    <GradientStop Color="#99201040" Offset="0.55" />
                    <GradientStop Color="#99062A30" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Soft aurora glows behind the glass cards. -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="360" Height="360" Canvas.Left="-120" Canvas.Top="-90" Opacity="0.55">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF2B7CFF" /><GradientStop Color="#002B7CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="380" Height="380" Canvas.Left="200" Canvas.Top="300" Opacity="0.45">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF8A4DFF" /><GradientStop Color="#008A4DFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="340" Height="340" Canvas.Left="-100" Canvas.Top="560" Opacity="0.4">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF00D1C1" /><GradientStop Color="#0000D1C1" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <DockPanel>
            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="16,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DupliXon" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
                <StackPanel>
                    <!-- Hero -->
                    <TextBlock Text="Duplica tu pantalla" FontSize="28" FontWeight="Bold" Margin="4,6,0,2" />
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,18">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SuccessBrush}" Visibility="{Binding IsReady, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        <TextBlock Text="{Binding EncoderName, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                   Visibility="{Binding EncoderName, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <!-- Setup error -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" BorderBrush="#88FF9F0A"
                            Visibility="{Binding SetupError, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding SetupError}" TextWrapping="Wrap" FontSize="14" />
                    </Border>

                    <!-- Pair card -->
                    <Border Style="{StaticResource GlassCard}" Padding="24" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <Border Background="White" CornerRadius="22" Padding="18" HorizontalAlignment="Center">
                                <Image Source="{Binding QrCode}" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock Text="Escanea con la cámara de tu iPad o iPhone" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,4" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Se abrirá Safari. Acepta la solicitud aquí y listo — sin instalar nada."
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                            <Border Style="{StaticResource SegmentHost}" Margin="0,16,0,0" Padding="12,6,6,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="10,6" Command="{Binding CopyUrlCommand}" ToolTip="Copiar enlace">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                    </Button>
                                    <TextBlock Text="{Binding Url}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Devices -->
                    <TextBlock Text="DISPOSITIVOS CONECTADOS" Style="{StaticResource Caption}" Margin="4,22,0,10" />
                    <Border Style="{StaticResource GlassCard}" Padding="8">
                        <Grid>
                            <TextBlock Text="Ningún dispositivo todavía" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                       Margin="12,10" Visibility="{Binding HasDevices, Converter={StaticResource Hidden}}" />
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                        <DockPanel Margin="8,6">
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Desconectar" FontSize="12"
                                                    Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" />
                                            <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <TextBlock Text="AJUSTES" Style="{StaticResource Caption}" Margin="4,22,0,10" />
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="Pantalla a compartir" FontSize="13" Margin="2,0,0,8" />
                            <Border Style="{StaticResource SegmentHost}">
                                <ItemsControl ItemsSource="{Binding Monitors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MonitorOption}">
                                            <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}"
                                                    Tag="{Binding IsSelected, Converter={StaticResource Seg}, ConverterParameter=True}"
                                                    Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock Text="Resolución" FontSize="13" Margin="2,16,0,8" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <Button Style="{StaticResource SegmentButton}" Content="Auto" ToolTip="Nativa del dispositivo"
                                            Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=Auto}"
                                            Command="{Binding SetQualityCommand}" CommandParameter="Auto" />
                                    <Button Style="{StaticResource SegmentButton}" Content="1080p"
                                            Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=FullHd}"
                                            Command="{Binding SetQualityCommand}" CommandParameter="FullHd" />
                                    <Button Style="{StaticResource SegmentButton}" Content="1440p"
                                            Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=QuadHd}"
                                            Command="{Binding SetQualityCommand}" CommandParameter="QuadHd" />
                                    <Button Style="{StaticResource SegmentButton}" Content="4K"
                                            Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=UltraHd}"
                                            Command="{Binding SetQualityCommand}" CommandParameter="UltraHd" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="Fluidez" FontSize="13" Margin="2,16,0,8" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <Button Style="{StaticResource SegmentButton}" Content="60 fps · Fluido"
                                            Tag="{Binding Fps, Converter={StaticResource Seg}, ConverterParameter=60}"
                                            Command="{Binding SetFpsCommand}" CommandParameter="60" />
                                    <Button Style="{StaticResource SegmentButton}" Content="30 fps · Ahorro"
                                            Tag="{Binding Fps, Converter={StaticResource Seg}, ConverterParameter=30}"
                                            Command="{Binding SetFpsCommand}" CommandParameter="30" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Los cambios se aplican a la próxima conexión. La resolución nunca supera la de tu pantalla."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Incoming request sheet -->
        <Grid Visibility="{Binding PendingRequest, Converter={StaticResource Visible}}" Background="#8C000000">
            <Border Style="{StaticResource GlassCard}" Width="360" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#E6283048" Offset="0" />
                        <GradientStop Color="#E61A1A2E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE70A;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding PendingTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding PendingDetail}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" />
                    <UniformGrid Rows="1" Margin="0,22,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Rechazar" Margin="0,0,6,0" Padding="18,11" Command="{Binding RejectCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Aceptar" Margin="6,0,0,0" Command="{Binding AcceptCommand}" IsDefault="True" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
