<Window x:Class="DupliXon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DupliXon.App.ViewModels"
        xmlns:v="clr-namespace:DupliXon.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DupliXon" Width="1120" Height="660" MinWidth="1060" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Icon="/Assets/DupliXon.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:SegmentStateConverter x:Key="Seg" />
        <v:VisibleWhenConverter x:Key="Visible" />
        <v:VisibleWhenConverter x:Key="Hidden" Invert="True" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Tint over the system acrylic; also the fallback look on Windows 10. -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#99101830" Offset="0" />
                    <GradientStop Color="#99201040" Offset="0.55" />
                    <GradientStop Color="#99062A30" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Soft aurora glows behind the glass cards. -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="460" Height="460" Canvas.Left="-140" Canvas.Top="-140" Opacity="0.55">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF2B7CFF" /><GradientStop Color="#002B7CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Left="420" Canvas.Top="260" Opacity="0.45">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF8A4DFF" /><GradientStop Color="#008A4DFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="440" Height="440" Canvas.Left="820" Canvas.Top="-120" Opacity="0.4">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF00D1C1" /><GradientStop Color="#0000D1C1" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="-8,0,-18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DupliXon" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- Header: title, status, mode switch -->
            <Grid Grid.Row="1" Margin="0,4,0,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Comparte tu pantalla" FontSize="28" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SuccessBrush}" Visibility="{Binding IsReady, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        <TextBlock Text="{Binding EncoderName, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                   Visibility="{Binding EncoderName, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource SegmentHost}" CornerRadius="16" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Center" Width="400">
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource SegmentButton}" Padding="10,10" FontSize="14"
                                Tag="{Binding Mode, Converter={StaticResource Seg}, ConverterParameter=Mirror}"
                                Command="{Binding SetModeCommand}" CommandParameter="Mirror">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                <TextBlock Text="Duplicar" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SegmentButton}" Padding="10,10" FontSize="14"
                                Tag="{Binding Mode, Converter={StaticResource Seg}, ConverterParameter=Extend}"
                                Command="{Binding SetModeCommand}" CommandParameter="Extend">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                <TextBlock Text="Segunda pantalla" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- Three columns: pair · devices/mode · settings -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Pair card -->
                <Border Style="{StaticResource GlassCard}" Padding="22">
                    <Grid>
                        <TextBlock Text="{Binding SetupError}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"
                                   Visibility="{Binding SetupError, Converter={StaticResource Visible}}" />
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                            <Border Background="White" CornerRadius="22" Padding="16" HorizontalAlignment="Center">
                                <Image Source="{Binding QrCode}" Width="184" Height="184" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock Text="Escanea con tu iPad o iPhone" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,4" TextAlignment="Center" />
                            <TextBlock Text="Se abrirá Safari. Acepta la solicitud aquí y listo, sin instalar nada."
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                            <Border Style="{StaticResource SegmentHost}" Margin="0,16,0,0" Padding="12,6,6,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="10,6" Command="{Binding CopyUrlCommand}" ToolTip="Copiar enlace">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                    </Button>
                                    <TextBlock Text="{Binding Url}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: devices + second-screen status -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassCard}" Padding="18,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DISPOSITIVOS CONECTADOS" Style="{StaticResource Caption}" />
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasDevices, Converter={StaticResource Hidden}}">
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center" Opacity="0.5" />
                                    <TextBlock Text="Ningún dispositivo todavía" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                            <Border Background="#14FFFFFF" CornerRadius="16" Padding="10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Desconectar" FontSize="12"
                                                            Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center" />
                                                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Second screen: driver missing -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18,16" BorderBrush="#665AC8FA"
                            Visibility="{Binding ShowVirtualSetup, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Activa la segunda pantalla" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,12"
                                       Text="Windows necesita una pantalla virtual para extender el escritorio. Se instala una sola vez (gratis y de código abierto) y pedirá permiso de administrador." />
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Command="{Binding InstallVirtualDisplayCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Instalar pantalla virtual" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstallingDriver}" Value="True">
                                                        <Setter Property="Text" Value="Instalando…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource BaseButton}" Margin="6,0,0,0" Content="Buscar de nuevo" Command="{Binding RefreshDisplaysCommand}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding VirtualHint}" TextWrapping="Wrap" FontSize="12.5" Foreground="#FFFFB340" Margin="2,10,0,0"
                                       Visibility="{Binding VirtualHint, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>

                    <!-- Second screen: ready -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18,14"
                            Visibility="{Binding ShowVirtualReady, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="Organizar" FontSize="12"
                                    ToolTip="Abrir Configuración de pantalla de Windows" Command="{Binding OpenDisplaySettingsCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding VirtualDisplay}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Se ajusta sola a la resolución de tu iPad al conectar." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Settings -->
                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="AJUSTES" Style="{StaticResource Caption}" />

                        <TextBlock Text="Control desde el dispositivo" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource SegmentButton}" Content="Ratón y teclado"
                                        Tag="{Binding AllowControl, Converter={StaticResource Seg}, ConverterParameter=True}"
                                        Command="{Binding SetControlCommand}" CommandParameter="on" />
                                <Button Style="{StaticResource SegmentButton}" Content="Solo ver"
                                        Tag="{Binding AllowControl, Converter={StaticResource Seg}, ConverterParameter=False}"
                                        Command="{Binding SetControlCommand}" CommandParameter="off" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Sonido" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource SegmentButton}" Content="En el dispositivo"
                                        Tag="{Binding Audio, Converter={StaticResource Seg}, ConverterParameter=True}"
                                        Command="{Binding SetAudioCommand}" CommandParameter="on" />
                                <Button Style="{StaticResource SegmentButton}" Content="Solo en el PC"
                                        Tag="{Binding Audio, Converter={StaticResource Seg}, ConverterParameter=False}"
                                        Command="{Binding SetAudioCommand}" CommandParameter="off" />
                            </UniformGrid>
                        </Border>

                        <StackPanel Visibility="{Binding IsMirror, Converter={StaticResource Visible}}">
                            <TextBlock Text="Pantalla a duplicar" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding Monitors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MonitorOption}">
                                            <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}"
                                                    Tag="{Binding IsSelected, Converter={StaticResource Seg}, ConverterParameter=True}"
                                                    Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Resolución" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource SegmentButton}" Content="Auto" ToolTip="Nativa del dispositivo"
                                        Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=Auto}"
                                        Command="{Binding SetQualityCommand}" CommandParameter="Auto" />
                                <Button Style="{StaticResource SegmentButton}" Content="1080p"
                                        Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=FullHd}"
                                        Command="{Binding SetQualityCommand}" CommandParameter="FullHd" />
                                <Button Style="{StaticResource SegmentButton}" Content="1440p"
                                        Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=QuadHd}"
                                        Command="{Binding SetQualityCommand}" CommandParameter="QuadHd" />
                                <Button Style="{StaticResource SegmentButton}" Content="4K"
                                        Tag="{Binding Quality, Converter={StaticResource Seg}, ConverterParameter=UltraHd}"
                                        Command="{Binding SetQualityCommand}" CommandParameter="UltraHd" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Fluidez" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource SegmentButton}" Content="60 fps"
                                        Tag="{Binding Fps, Converter={StaticResource Seg}, ConverterParameter=60}"
                                        Command="{Binding SetFpsCommand}" CommandParameter="60" />
                                <Button Style="{StaticResource SegmentButton}" Content="30 fps"
                                        Tag="{Binding Fps, Converter={StaticResource Seg}, ConverterParameter=30}"
                                        Command="{Binding SetFpsCommand}" CommandParameter="30" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Se aplican a la próxima conexión."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Incoming request sheet -->
        <Grid Visibility="{Binding PendingRequest, Converter={StaticResource Visible}}" Background="#8C000000">
            <Border Style="{StaticResource GlassCard}" Width="380" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#E6283048" Offset="0" />
                        <GradientStop Color="#E61A1A2E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE70A;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding PendingTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding PendingDetail}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" />
                    <UniformGrid Rows="1" Margin="0,22,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Rechazar" Margin="0,0,6,0" Padding="18,11" Command="{Binding RejectCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Aceptar" Margin="6,0,0,0" Command="{Binding AcceptCommand}" IsDefault="True" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

