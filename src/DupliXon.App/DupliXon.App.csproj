<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DupliXon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\DupliXon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <ProjectReference Include="..\DupliXon.Server\DupliXon.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\DupliXon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
